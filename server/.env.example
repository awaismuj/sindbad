APP_ENV=production
APP_URL=https://www.sindbadsolution.com
# MongoDB Atlas: Connect > Drivers > copy the mongodb+srv URI (add your VPS IP in Atlas Network Access)
MONGO_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=sindbad
# Session cookie
SESSION_NAME=sindbad_sid
# Initial Super Admin (used only by scripts/seed.php, then change the password)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD
# Upload folder (outside the web root source tree)
UPLOAD_DIR=/var/www/sindbad/uploads

# Where the built React app lives (used to inject SEO tags into index.html)
DIST_DIR=/var/www/sindbad/client/dist
# Email notifications for new enquiries, demo requests and job applications (optional).
# Leave SMTP_HOST empty to disable. The recipient is set in Admin > Settings (Notification email).
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS (port 587), ssl = implicit TLS (port 465), none = no encryption (local testing only)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
