APP_ENV=production
APP_URL=https://sindbadsolution.com
# MongoDB (local on the VPS, auth enabled)
MONGO_URI=mongodb://sindbad_app:CHANGE_ME@127.0.0.1:27017/sindbad?authSource=sindbad
MONGO_DB=sindbad
# Session cookie
SESSION_NAME=sindbad_sid
# Initial Super Admin (used only by scripts/seed.php, then change the password)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD
# Upload folder (outside the web root source tree)
UPLOAD_DIR=/var/www/sindbad/uploads
